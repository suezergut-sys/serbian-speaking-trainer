# Keep the permanent key on the backend only.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIBE_LANGUAGE_PARAMETER=language
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Admin experiment allowlist; model IDs and endpoint language contract stay in env.
OPENAI_TRANSCRIBE_MODELS=[{"model":"gpt-transcribe","language_parameter":"languages"},{"model":"gpt-4o-transcribe","language_parameter":"language"},{"model":"gpt-4o-mini-transcribe","language_parameter":"language"},{"model":"gpt-4o-mini-transcribe-2025-12-15","language_parameter":"language"},{"model":"whisper-1","language_parameter":"language"}]
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
OPENAI_ASSISTANCE_TIMEOUT_SECONDS=6
OPENAI_ASSISTANCE_MAX_RETRIES=0
MAX_AUDIO_BYTES=1000000

DATABASE_URL=sqlite:///./data/serbian_trainer.db
APP_ENV=development
CORS_ALLOWED_ORIGIN_REGEX=https://serbian-speaking-trainer(?:-[a-z0-9-]+)?\.vercel\.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
ADMIN_EMAILS=suezergut@gmail.com
FREE_DAILY_PHRASE_LIMIT=20
PREMIUM_DAILY_PHRASE_LIMIT=100
AUTH_TIMEOUT_SECONDS=5
AUTH_MAX_RETRIES=1
REVIEW_LOGIN_USERNAME=serbotalkreview
# Backend only: dedicated review account email, never a VITE variable.
REVIEW_LOGIN_EMAIL=

DEFAULT_LEVEL=A2
DEFAULT_SESSION_LENGTH=20
AUTO_NEXT=true

MASTERY_CONSOLIDATING_THRESHOLD=0.65
MASTERY_MASTERED_THRESHOLD=0.85
LONG_REACTION_MS=2500
LONG_INTERNAL_PAUSE_MS=1500

VAD_MODE=server_vad
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=700

# Optional backend-only activity notifications; never use VITE_ for these secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=3
