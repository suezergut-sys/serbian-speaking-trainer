# Keep the permanent key on the backend only.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2
MAX_AUDIO_BYTES=1000000

DATABASE_URL=sqlite:///./data/serbian_trainer.db
APP_ENV=development

DEFAULT_LEVEL=A2
DEFAULT_SESSION_LENGTH=20
AUTO_NEXT=true

MASTERY_CONSOLIDATING_THRESHOLD=0.65
MASTERY_MASTERED_THRESHOLD=0.85
LONG_REACTION_MS=2500
LONG_INTERNAL_PAUSE_MS=1500

VAD_MODE=server_vad
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=700
